# Copy to .deploy.env (it is git-ignored) and fill in.

# user@host of the VPS
SERVER="root@203.0.113.10"

# Folder on the server with .env.prod (see DEPLOY.md). Its name decides the Docker volume
# names, so keep it "portfolio" to match the backup commands in DEPLOY.md.
REMOTE_DIR="/opt/portfolio"

SSH_PORT="22"
# Optional path to a private key, e.g. ~/.ssh/id_ed25519
SSH_KEY=""
