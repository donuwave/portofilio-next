generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaType {
  image
  video
}

enum ProjectStatus {
  draft
  published
}

/// Singleton — always the single row with id = 1
model Profile {
  id      Int    @id @default(1)
  name    String
  role    Json
  avatarId String? @unique
  avatar  Media?  @relation(fields: [avatarId], references: [id])
  about   Json

  currentJobCompany     String?
  currentJobPosition    Json?
  currentJobFrom        DateTime?
  currentJobDescription Json?

  skills String[]

  experience Experience[]

  updatedAt DateTime @updatedAt
}

model Experience {
  id          String    @id @default(cuid())
  profileId   Int       @default(1)
  profile     Profile   @relation(fields: [profileId], references: [id])
  company     String
  position    Json
  dateFrom    DateTime
  dateTo      DateTime?
  description Json
  order       Int       @default(0)
  logoId      String?
  logo        Media?    @relation(fields: [logoId], references: [id])
  // How the logo sits inside its square frame: zoom factor and pan offset (fractions of the frame size).
  // Optional link to the company / school site, opened in a new tab.
  url         String?
  logoZoom    Float     @default(1)
  logoX       Float     @default(0)
  logoY       Float     @default(0)

  @@index([profileId])
}

model Project {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       Json
  description Json
  // Who the product is for ("Заказчик", "Перевозчик"...), shown as a label.
  tag         Json?
  coverId     String?
  cover       Media?        @relation("ProjectCover", fields: [coverId], references: [id])
  // A short demo clip shown at the very top of the project page.
  demoVideoId String?
  demoVideo   Media?        @relation("ProjectDemoVideo", fields: [demoVideoId], references: [id])
  // Links to the source code: [{ "label": "Frontend", "url": "https://github.com/…" }].
  repos       Json          @default("[]")
  techStack   String[]
  status      ProjectStatus @default(draft)
  order       Int           @default(0)

  cases Case[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, order])
}

model Case {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       Json
  description Json
  order       Int     @default(0)

  media CaseMedia[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, order])
}

model Media {
  id       String    @id @default(cuid())
  type     MediaType
  filename String
  path     String
  size     Int
  mimeType String

  cases                CaseMedia[]
  usedAsCover          Project[]      @relation("ProjectCover")
  usedAsDemoVideo      Project[]      @relation("ProjectDemoVideo")
  usedAsAvatarOf       Profile?
  usedAsExperienceLogo Experience[]

  createdAt DateTime @default(now())
}

/// Join table: many-to-many between Case and Media, with per-case display order
model CaseMedia {
  caseId  String
  case    Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  mediaId String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  order   Int    @default(0)
  // How an image sits in the slider frame: zoom factor and pan offset (fractions of the frame size).
  zoom    Float  @default(1)
  offsetX Float  @default(0)
  offsetY Float  @default(0)

  @@id([caseId, mediaId])
  @@index([mediaId])
}

model ContactRequest {
  id        String   @id @default(cuid())
  name      String
  contact   String
  message   String
  read      Boolean  @default(false)
  // When the sender ticked the personal-data consent box (152-FZ).
  consentAt DateTime?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
