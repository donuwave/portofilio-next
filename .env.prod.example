# Copy to .env.prod on the server and fill in. Never commit .env.prod.

# Your domain, without https:// and without www.
DOMAIN="tareev-daniil.ru"

# Letters and digits only (it ends up inside a URL): openssl rand -hex 24
POSTGRES_PASSWORD="change-me"

# openssl rand -base64 32
AUTH_SECRET="change-me"

ADMIN_EMAIL="you@example.com"
# Use SINGLE quotes and do NOT escape the "$" here (compose reads this file, not Next):
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
ADMIN_PASSWORD_HASH='$2b$12$change-me'

# Optional: forward contact-form requests to Telegram.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Public URL of the site with https:// (no trailing slash). Used for hreflang/canonical links.
SITE_URL="https://tareev-daniil.ru"

# Yandex Metrica counter number (digits only). Leave empty until you have one:
# without it there is no cookie banner and no analytics.
YANDEX_METRIKA_ID=""
