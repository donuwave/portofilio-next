DATABASE_URL="postgresql://portfolio:portfolio@localhost:5433/portfolio?schema=public"

# Path on disk where uploaded media (photos/videos) are stored
UPLOADS_DIR="./data/uploads"

# Session/auth secret for the admin login (generate with `openssl rand -base64 32`)
AUTH_SECRET="change-me"

# Single-owner admin login (no registration flow — set these by hand).
# Generate ADMIN_PASSWORD_HASH with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
# Next.js expands $VAR in .env values, so escape every "$" in the hash as "\$"
# or it gets silently corrupted (e.g. "$2b$12$abc..." -> "\$2b\$12\$abc...").
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD_HASH="change-me"

# Optional: forward contact-form requests to Telegram. Create a bot via
# @BotFather for the token; the chat id is your own (e.g. from @userinfobot).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Public URL of the site (hreflang/canonical links). Optional locally.
SITE_URL=""

# Yandex Metrica counter number. Empty = no analytics and no cookie banner.
YANDEX_METRIKA_ID=""
